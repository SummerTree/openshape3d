# OCCT B-rep port: the prebuilt OCCT.xcframework is committed via Git LFS (its
# two static libs are tracked by .gitattributes) so a fresh checkout builds
# without running scripts/build_occt_ios.sh. Only the local build scratch dir
# is ignored.
.occt-build/

# App Store / website capture output (not source)
marketing/
